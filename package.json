{
  "name": "invest-factors",
  "version": "1.0.0",
  "author": "Prokhor Orlov",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "yarn --cwd frontend build",
    "start": "yarn --cwd backend start",
    "restart": "yarn run lint && yarn run build && pm2 restart investfactors",
    "dev": "sh _ci/start_dev.sh",
    "postinstall": "husky install",
    "deploy": "sh _ci/deploy.sh",
    "lint": "yarn --cwd frontend lint && yarn --cwd backend lint",
    "lint:fix": "yarn --cwd frontend lint:fix && yarn --cwd backend lint:fix",
    "format": "prettier --write \"{backend,frontend}/**/*.{js,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"{backend,frontend}/**/*.{js,vue,json,css,scss,md}\"",
    "test": "yarn --cwd frontend test && yarn --cwd backend test",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules",
    "reinstall": "yarn clean && yarn install"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "husky": "^7.0.1"
  }
}
